{
  "name": "volume-hero",
  "description": "Boost audio/video volume beyond 100% (up to 600%) with per-site memory",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "prepare": "lefthook install",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@ark-ui/solid": "^5.37.0",
    "@bradenmacdonald/s3-lite-client": "0.9.6",
    "@inlang/paraglide-js": "^2.18.1",
    "@tailwindcss/vite": "^4.1.17",
    "clsx": "^2.1.1",
    "es-toolkit": "^1.42.0",
    "lucide-solid": "^1.17.0",
    "solid-js": "^1.9.9",
    "solid-toast": "^0.5.0",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@wxt-dev/auto-icons": "^1.1.0",
    "@wxt-dev/module-solid": "^1.1.4",
    "baseline-browser-mapping": "^2.10.35",
    "lefthook": "^2.0.7",
    "typescript": "^6.0.3",
    "wxt": "^0.20.26"
  },
  "packageManager": "bun@1.3.3"
}
